<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bulletin_professional"
              pageWidth="595" pageHeight="842" orientation="Portrait"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="15" bottomMargin="15"
              whenNoDataType="AllSectionsNoDetail">

  <!-- ===== PARAMETERS ===== -->
  <parameter name="studentName"        class="java.lang.String"/>
  <parameter name="registrationNumber" class="java.lang.String"/>
  <parameter name="className"          class="java.lang.String"/>
  <parameter name="classEffective"     class="java.lang.String"/>
  <parameter name="periodLabel"        class="java.lang.String"/>
  <parameter name="academicYear"       class="java.lang.String"/>
  <parameter name="globalAverage"      class="java.lang.String"/>
  <parameter name="rank"               class="java.lang.String"/>
  <parameter name="mention"            class="java.lang.String"/>
  <parameter name="institutionName"    class="java.lang.String"/>
  <parameter name="institutionAddress" class="java.lang.String"/>
  <parameter name="institutionPhone"   class="java.lang.String"/>
  <parameter name="institutionType"    class="java.lang.String"/>
  <parameter name="motto"              class="java.lang.String"/>
  <parameter name="watermarkText"      class="java.lang.String"/>
  <parameter name="logoBase64"         class="java.lang.String"/>
  <parameter name="absences"           class="java.lang.String"/>
  <parameter name="principalName"      class="java.lang.String"/>
  <parameter name="principalSignatureBase64" class="java.lang.String"/>
  <parameter name="primaryColor"       class="java.lang.String" isForPrompting="false">
    <defaultValueExpression><![CDATA["#1A237E"]]></defaultValueExpression>
  </parameter>
  <parameter name="primaryColorImage"  class="java.awt.Image" isForPrompting="false"/>
  <parameter name="accentColorImage"   class="java.awt.Image" isForPrompting="false"/>

  <!-- ===== FIELDS ===== -->
  <field name="subjectName"  class="java.lang.String"/>
  <field name="coefficient"  class="java.lang.String"/>
  <field name="average"      class="java.lang.String"/>
  <field name="total"        class="java.lang.String"/>
  <field name="rank"         class="java.lang.String"/>
  <field name="classMax"     class="java.lang.String"/>
  <field name="classMin"     class="java.lang.String"/>
  <field name="classAverage" class="java.lang.String"/>
  <field name="remarks"      class="java.lang.String"/>
  <field name="teacherName"  class="java.lang.String"/>
  <field name="averageDouble" class="java.lang.Double"/>

  <!-- ===== BACKGROUND WATERMARK ===== -->
  <background>
    <band height="812">
      <textField>
        <reportElement x="50" y="150" width="500" height="400" forecolor="#F0F0F0"/>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left">
          <font fontName="DejaVu Sans" size="60" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{watermarkText} != null ? $P{watermarkText} : $P{institutionName}]]></textFieldExpression>
      </textField>
    </band>
  </background>

  <!-- ===== TITLE — Rich dark header ===== -->
  <title>
    <band height="120" splitType="Stretch">

      <!-- Dark header band (Dynamic Color) -->
      <image scaleImage="FillFrame">
        <reportElement x="0" y="0" width="535" height="85"/>
        <imageExpression><![CDATA[$P{primaryColorImage}]]></imageExpression>
      </image>
      <!-- Accent stripe -->
      <rectangle>
        <reportElement x="0" y="85" width="535" height="5" forecolor="#FFC107" backcolor="#FFC107"/>
      </rectangle>

      <!-- Logo -->
      <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
        <reportElement x="8" y="6" width="65" height="65"/>
        <imageExpression><![CDATA[
          $P{logoBase64} != null && !$P{logoBase64}.isEmpty()
            ? new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode(
                $P{logoBase64}.contains(",") ? $P{logoBase64}.split(",")[1] : $P{logoBase64}))
            : null
        ]]></imageExpression>
      </image>

      <!-- School name -->
      <textField>
        <reportElement x="80" y="8" width="350" height="22" forecolor="#FFFFFF"/>
        <textElement><font fontName="DejaVu Sans" size="14" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{institutionName}]]></textFieldExpression>
      </textField>

      <!-- School type + address -->
      <textField isBlankWhenNull="true">
        <reportElement x="80" y="30" width="350" height="12" forecolor="#90CAF9"/>
        <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
        <textFieldExpression><![CDATA[$P{institutionType} + "  |  " + ($P{institutionAddress} != null ? $P{institutionAddress} : "")]]></textFieldExpression>
      </textField>

      <!-- Phone + contact -->
      <textField isBlankWhenNull="true">
        <reportElement x="80" y="43" width="350" height="12" forecolor="#90CAF9"/>
        <textElement><font fontName="DejaVu Sans" size="7"/></textElement>
        <textFieldExpression><![CDATA["✆ " + ($P{institutionPhone} != null ? $P{institutionPhone} : "")]]></textFieldExpression>
      </textField>

      <!-- Right: Year badge -->
      <rectangle>
        <reportElement x="440" y="8" width="90" height="30" forecolor="#FFC107" backcolor="#FFC107"/>
      </rectangle>
      <textField>
        <reportElement x="440" y="8" width="90" height="14" forecolor="#1A237E"/>
        <textElement textAlignment="Center" verticalAlignment="Bottom"><font fontName="DejaVu Sans" size="6.5" isBold="true"/></textElement>
        <textFieldExpression><![CDATA["Année"]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="440" y="22" width="90" height="16" forecolor="#1A237E"/>
        <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{academicYear}]]></textFieldExpression>
      </textField>

      <!-- BULLETIN label in header -->
      <staticText>
        <reportElement x="0" y="60" width="535" height="22" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="13" isBold="true"/>
        </textElement>
        <text><![CDATA[★  BULLETIN DE NOTES  ★]]></text>
      </staticText>

      <!-- Period label below accent stripe -->
      <textField>
        <reportElement x="0" y="93" width="535" height="18" forecolor="#1A237E"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="9" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{periodLabel}]]></textFieldExpression>
      </textField>

    </band>
  </title>

  <!-- ===== PAGE HEADER — Student card ===== -->
  <pageHeader>
    <band height="55" splitType="Stretch">
      <!-- Card background -->
      <rectangle>
        <reportElement x="0" y="0" width="535" height="54" forecolor="#E8EAF6" backcolor="#E8EAF6"/>
        <graphicElement><pen lineWidth="1.5" lineColor="#1A237E"/></graphicElement>
      </rectangle>
      <!-- Left accent -->
      <rectangle>
        <reportElement x="0" y="0" width="4" height="54" forecolor="#1A237E" backcolor="#1A237E"/>
      </rectangle>

      <!-- Student name large -->
      <textField>
        <reportElement x="10" y="5" width="280" height="18" forecolor="#1A237E"/>
        <textElement><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{studentName}]]></textFieldExpression>
      </textField>

      <!-- Matricule -->
      <textField>
        <reportElement x="10" y="26" width="250" height="12" forecolor="#37474F"/>
        <textElement><font fontName="DejaVu Sans" size="7.5"/></textElement>
        <textFieldExpression><![CDATA["Matricule : " + $P{registrationNumber}]]></textFieldExpression>
      </textField>

      <!-- Class + effectif -->
      <textField>
        <reportElement x="10" y="38" width="250" height="12" forecolor="#37474F"/>
        <textElement><font fontName="DejaVu Sans" size="7.5"/></textElement>
        <textFieldExpression><![CDATA["Classe : " + $P{className} + "  —  Effectif : " + $P{classEffective}]]></textFieldExpression>
      </textField>

      <!-- Absences pill -->
      <rectangle>
        <reportElement x="395" y="20" width="136" height="28" forecolor="#FF8F00" backcolor="#FF8F00"/>
      </rectangle>
      <staticText>
        <reportElement x="395" y="20" width="136" height="14" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Bottom"><font fontName="DejaVu Sans" size="6.5" isBold="true"/></textElement>
        <text><![CDATA[Absences (jours)]]></text>
      </staticText>
      <textField isBlankWhenNull="true">
        <reportElement x="395" y="34" width="136" height="14" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$P{absences} != null ? $P{absences} : "0"]]></textFieldExpression>
      </textField>
    </band>
  </pageHeader>

  <!-- ===== COLUMN HEADER ===== -->
  <columnHeader>
    <band height="20">
      <!-- Dynamic header color -->
      <image scaleImage="FillFrame">
        <reportElement x="0" y="0" width="535" height="19"/>
        <imageExpression><![CDATA[$P{primaryColorImage}]]></imageExpression>
      </image>
      <staticText>
        <reportElement x="2" y="0" width="180" height="19" forecolor="#FFFFFF"/>
        <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
        <text><![CDATA[MATIÈRE]]></text>
      </staticText>
      <staticText>
        <reportElement x="182" y="0" width="55" height="19" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
        <text><![CDATA[MOY. /20]]></text>
      </staticText>
      <staticText>
        <reportElement x="237" y="0" width="40" height="19" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
        <text><![CDATA[COEF.]]></text>
      </staticText>
      <staticText>
        <reportElement x="277" y="0" width="50" height="19" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
        <text><![CDATA[RANG]]></text>
      </staticText>
      <staticText>
        <reportElement x="327" y="0" width="100" height="19" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
        <text><![CDATA[NIVEAU]]></text>
      </staticText>
      <staticText>
        <reportElement x="427" y="0" width="108" height="19" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isBold="true"/></textElement>
        <text><![CDATA[OBSERVATIONS]]></text>
      </staticText>
    </band>
  </columnHeader>

  <!-- ===== DETAIL — Grade bar row ===== -->
  <detail>
    <band height="22" splitType="Stretch">
      <rectangle>
        <reportElement x="0" y="0" width="535" height="21" forecolor="#FAFAFA" backcolor="#FAFAFA">
          <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
        </reportElement>
      </rectangle>

      <!-- Subject name -->
      <textField isBlankWhenNull="true">
        <reportElement x="4" y="3" width="176" height="15" forecolor="#212121"/>
        <textElement><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{subjectName}]]></textFieldExpression>
      </textField>

      <!-- Average with colored pill -->
      <rectangle>
        <reportElement x="183" y="3" width="52" height="15" forecolor="#E3F2FD" backcolor="#E3F2FD">
          <printWhenExpression><![CDATA[$F{averageDouble} != null && $F{averageDouble} >= 10.0]]></printWhenExpression>
        </reportElement>
      </rectangle>
      <rectangle>
        <reportElement x="183" y="3" width="52" height="15" forecolor="#FFEBEE" backcolor="#FFEBEE">
          <printWhenExpression><![CDATA[$F{averageDouble} != null && $F{averageDouble} < 10.0]]></printWhenExpression>
        </reportElement>
      </rectangle>
      <textField isBlankWhenNull="true">
        <reportElement x="183" y="3" width="52" height="15" forecolor="#1A237E">
          <printWhenExpression><![CDATA[$F{averageDouble} != null && $F{averageDouble} >= 10.0]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{average}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="183" y="3" width="52" height="15" forecolor="#C62828">
          <printWhenExpression><![CDATA[$F{averageDouble} == null || $F{averageDouble} < 10.0]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{average}]]></textFieldExpression>
      </textField>

      <textField isBlankWhenNull="true">
        <reportElement x="237" y="3" width="40" height="15" forecolor="#37474F"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
        <textFieldExpression><![CDATA[$F{coefficient}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="277" y="3" width="50" height="15" forecolor="#37474F"/>
        <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7.5"/></textElement>
        <textFieldExpression><![CDATA[$F{rank}]]></textFieldExpression>
      </textField>

      <!-- Mini progress bar based on average -->
      <rectangle>
        <reportElement x="327" y="8" width="100" height="6" forecolor="#E0E0E0" backcolor="#E0E0E0"/>
      </rectangle>
      <rectangle>
        <reportElement x="327" y="8" width="100" height="6" forecolor="#43A047" backcolor="#43A047">
          <printWhenExpression><![CDATA[$F{averageDouble} != null && $F{averageDouble} >= 15.0]]></printWhenExpression>
        </reportElement>
      </rectangle>
      <rectangle>
        <reportElement x="327" y="8" width="100" height="6" forecolor="#FFA726" backcolor="#FFA726">
          <printWhenExpression><![CDATA[$F{averageDouble} != null && $F{averageDouble} >= 10.0 && $F{averageDouble} < 15.0]]></printWhenExpression>
        </reportElement>
      </rectangle>
      <rectangle>
        <reportElement x="327" y="8" width="100" height="6" forecolor="#EF5350" backcolor="#EF5350">
          <printWhenExpression><![CDATA[$F{averageDouble} != null && $F{averageDouble} < 10.0]]></printWhenExpression>
        </reportElement>
      </rectangle>

      <textField isBlankWhenNull="true">
        <reportElement x="427" y="3" width="108" height="15" forecolor="#37474F"/>
        <textElement><font fontName="DejaVu Sans" size="7" isItalic="true"/></textElement>
        <textFieldExpression><![CDATA[$F{remarks}]]></textFieldExpression>
      </textField>

      <!-- Row separator -->
      <line><reportElement x="0" y="21" width="535" height="1" forecolor="#E0E0E0"/></line>
    </band>
  </detail>

  <!-- ===== PAGE FOOTER ===== -->
  <pageFooter>
    <band height="18">
      <rectangle>
        <reportElement x="0" y="0" width="535" height="3" forecolor="#FFC107" backcolor="#FFC107"/>
      </rectangle>
      <textField isBlankWhenNull="true">
        <reportElement x="0" y="5" width="380" height="11" forecolor="#37474F"/>
        <textElement><font fontName="DejaVu Sans" size="6.5" isItalic="true"/></textElement>
        <textFieldExpression><![CDATA[$P{motto} != null ? "❝ " + $P{motto} + " ❞" : ""]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="380" y="5" width="155" height="11" forecolor="#9E9E9E"/>
        <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="6.5"/></textElement>
        <textFieldExpression><![CDATA["Généré le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
      </textField>
    </band>
  </pageFooter>

  <!-- ===== SUMMARY — Results dashboard ===== -->
  <summary>
    <band height="170" splitType="Stretch">

      <!-- Average card (Dynamic Color) -->
      <image scaleImage="FillFrame">
        <reportElement x="0" y="10" width="165" height="80"/>
        <imageExpression><![CDATA[$P{primaryColorImage}]]></imageExpression>
      </image>
      <staticText>
        <reportElement x="0" y="12" width="165" height="14" forecolor="#90CAF9"/>
        <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
        <text><![CDATA[MOYENNE GÉNÉRALE]]></text>
      </staticText>
      <textField>
        <reportElement x="0" y="30" width="165" height="35" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="24" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{globalAverage}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="0" y="70" width="165" height="14" forecolor="#90CAF9"/>
        <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7.5"/></textElement>
        <text><![CDATA[/ 20]]></text>
      </staticText>

      <!-- Rank card -->
      <rectangle>
        <reportElement x="175" y="10" width="165" height="80" forecolor="#FFA000" backcolor="#FFA000"/>
      </rectangle>
      <staticText>
        <reportElement x="175" y="12" width="165" height="14" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
        <text><![CDATA[RANG DANS LA CLASSE]]></text>
      </staticText>
      <textField>
        <reportElement x="175" y="28" width="165" height="40" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="22" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{rank}]]></textFieldExpression>
      </textField>

      <!-- Mention card -->
      <rectangle>
        <reportElement x="350" y="10" width="185" height="80" forecolor="#2E7D32" backcolor="#2E7D32"/>
      </rectangle>
      <staticText>
        <reportElement x="350" y="12" width="185" height="14" forecolor="#C8E6C9"/>
        <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7.5" isBold="true"/></textElement>
        <text><![CDATA[MENTION]]></text>
      </staticText>
      <textField>
        <reportElement x="350" y="28" width="185" height="40" forecolor="#FFFFFF"/>
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="15" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{mention}]]></textFieldExpression>
      </textField>

      <!-- Signatures bar -->
      <line>
        <reportElement x="0" y="100" width="535" height="1" forecolor="#E0E0E0"/>
      </line>

      <staticText>
        <reportElement x="0" y="108" width="170" height="55" forecolor="#37474F"/>
        <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7"/></textElement>
        <text><![CDATA[Visa des Parents / Tuteurs :




_______________________]]></text>
      </staticText>

      <staticText>
        <reportElement x="185" y="108" width="165" height="55" forecolor="#37474F"/>
        <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7"/></textElement>
        <text><![CDATA[Professeur Principal :




_______________________]]></text>
      </staticText>

      <textField isBlankWhenNull="true">
        <reportElement x="365" y="108" width="170" height="12" forecolor="#37474F"/>
        <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7"/></textElement>
        <textFieldExpression><![CDATA["Le Directeur : " + ($P{principalName} != null ? $P{principalName} : "")]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="365" y="122" width="170" height="40" forecolor="#37474F"/>
        <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="7"/></textElement>
        <text><![CDATA[Signature et Cachet :




_______________________]]></text>
      </staticText>

      <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
        <reportElement x="380" y="132" width="140" height="28"/>
        <imageExpression><![CDATA[
          $P{principalSignatureBase64} != null && !$P{principalSignatureBase64}.isEmpty()
            ? new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode(
                $P{principalSignatureBase64}.contains(",") ? $P{principalSignatureBase64}.split(",")[1] : $P{principalSignatureBase64}))
            : null
        ]]></imageExpression>
      </image>
    </band>
  </summary>
</jasperReport>
