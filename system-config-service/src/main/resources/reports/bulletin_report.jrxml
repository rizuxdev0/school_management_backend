            </rectangle>
            <!-- Ligne de séparation -->
            <line><reportElement x="0" y="0" width="535" height="1" forecolor="#d1d5db" uuid="footer-top-line"/></line>

            <!-- DEVISE / SLOGAN -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="4" width="350" height="12" forecolor="#6b7280" uuid="footer-motto"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    ($P{SCHOOL_MOTTO} != null &amp;&amp; !$P{SCHOOL_MOTTO}.isEmpty())
                    ? "« " + $P{SCHOOL_MOTTO} + " »" : ""
                ]]></textFieldExpression>
            </textField>

            <!-- DATE DE GÉNÉRATION -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="350" height="10" forecolor="#9ca3af" uuid="footer-date"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="6"/>
                </textElement>
                <textFieldExpression><![CDATA["Édité le : " + $P{GENERATED_DATE}]]></textFieldExpression>
            </textField>

            <!-- PAGINATION -->
            <textField>
                <reportElement x="390" y="4" width="145" height="22" forecolor="#374151" uuid="footer-page"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

            <!-- COORDONNÉES EN BAS -->
            <textField isBlankWhenNull="true">
                <reportElement x="350" y="14" width="185" height="12" forecolor="#9ca3af" uuid="footer-contacts"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="6"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    ($P{SCHOOL_WEBSITE} != null &amp;&amp; !$P{SCHOOL_WEBSITE}.isEmpty()) ? $P{SCHOOL_WEBSITE} : ""
                ]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Force un saut de page entre chaque élève -->
    <lastPageFooter>
        <band height="32">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="28" forecolor="#f3f4f6" backcolor="#f3f4f6" uuid="last-footer-bg"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <line><reportElement x="0" y="0" width="535" height="1" forecolor="#d1d5db" uuid="last-footer-line"/></line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="4" width="350" height="12" forecolor="#6b7280" uuid="last-footer-motto"/>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[
                    ($P{SCHOOL_MOTTO} != null &amp;&amp; !$P{SCHOOL_MOTTO}.isEmpty())
                    ? "« " + $P{SCHOOL_MOTTO} + " »" : ""
                ]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="390" y="4" width="145" height="22" forecolor="#374151" uuid="last-footer-page"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / " + $V{PAGE_COUNT}  + " — Fin du document"]]></textFieldExpression>
            </textField>
        </band>
    </lastPageFooter>

</jasperReport>
