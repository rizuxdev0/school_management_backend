<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
  name="payment_receipt"
  pageWidth="595" pageHeight="842" orientation="Portrait"
  columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
  whenNoDataType="AllSectionsNoDetail">

  <parameter name="institutionName" class="java.lang.String" />
  <parameter name="institutionType" class="java.lang.String" />
  <parameter name="institutionAddress" class="java.lang.String" />
  <parameter name="institutionPhone" class="java.lang.String" />
  <parameter name="institutionEmail" class="java.lang.String" />
  <parameter name="motto" class="java.lang.String" />
  <parameter name="logoBase64" class="java.lang.String" />
  <parameter name="primaryColorImage" class="java.awt.Image" isForPrompting="false" />
  <parameter name="receiptNumber" class="java.lang.String" />
  <parameter name="receiptDate" class="java.lang.String" />
  <parameter name="studentName" class="java.lang.String" />
  <parameter name="registrationNumber" class="java.lang.String" />
  <parameter name="className" class="java.lang.String" />
  <parameter name="academicYear" class="java.lang.String" />
  <parameter name="paymentMethod" class="java.lang.String" />
  <parameter name="amountPaid" class="java.lang.String" />
  <parameter name="amountPaidWords" class="java.lang.String" />
  <parameter name="notes" class="java.lang.String" />
  <parameter name="currencySymbol" class="java.lang.String" />
  <parameter name="totalExigible" class="java.lang.String" />
  <parameter name="totalPaid" class="java.lang.String" />
  <parameter name="balance" class="java.lang.String" />

  <field name="feeName" class="java.lang.String" />
  <field name="installment" class="java.lang.String" />
  <field name="amountDue" class="java.lang.String" />
  <field name="amountPaidF" class="java.lang.String" />
  <field name="status" class="java.lang.String" />

  <title>
    <band height="155" splitType="Stretch">
      <image scaleImage="FillFrame">
        <reportElement x="0" y="0" width="535" height="6" />
        <imageExpression><![CDATA[$P{primaryColorImage}]]></imageExpression>
      </image>
      <image scaleImage="RetainShape" onErrorType="Blank">
        <reportElement x="0" y="12" width="68" height="68" />
        <!-- <imageExpression><![CDATA[
          ($P{logoBase64} != null && !$P{logoBase64}.trim().isEmpty())
          ? javax.imageio.ImageIO().read(new
        java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode($P{logoBase64}.replaceAll("data:image/[a-z]+;base64,",""))))
          : null
        ]]></imageExpression> -->
        <imageExpression><![CDATA[
  ($P{logoBase64} != null && !$P{logoBase64}.trim().isEmpty())
  ? javax.imageio.ImageIO.read(new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode($P{logoBase64}.replaceAll("data:image/[a-z]+;base64,",""))))
  : null
]]></imageExpression>
      </image>
      <textField isBlankWhenNull="true">
        <reportElement x="78" y="12" width="380" height="22" />
        <textElement verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="14" isBold="true" />
        </textElement>
        <textFieldExpression><![CDATA[$P{institutionName}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="78" y="34" width="380" height="13" />
        <textElement verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="8" isItalic="true" />
        </textElement>
        <textFieldExpression><![CDATA["Etablissement " + ($P{institutionType} != null ? $P{institutionType} : "")]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="78" y="48" width="380" height="12" />
        <textElement>
          <font fontName="DejaVu Sans" size="8" />
        </textElement>
        <textFieldExpression><![CDATA[$P{institutionAddress}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="78" y="60" width="200" height="12" />
        <textElement>
          <font fontName="DejaVu Sans" size="8" />
        </textElement>
        <textFieldExpression><![CDATA["Tel : " + ($P{institutionPhone} != null ? $P{institutionPhone} : "")]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="280" y="60" width="235" height="12" />
        <textElement>
          <font fontName="DejaVu Sans" size="8" />
        </textElement>
        <textFieldExpression><![CDATA["Email : " + ($P{institutionEmail} != null ? $P{institutionEmail} : "")]]></textFieldExpression>
      </textField>
      <line>
        <reportElement x="0" y="86" width="535" height="1" />
        <graphicElement>
          <pen lineWidth="0.5" lineColor="#CCCCCC" />
        </graphicElement>
      </line>
      <staticText>
        <reportElement x="0" y="92" width="535" height="22" />
        <textElement textAlignment="Center" verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="13" isBold="true" />
        </textElement>
        <text><![CDATA[RECU DE PAIEMENT DE SCOLARITE]]></text>
      </staticText>
      <staticText>
        <reportElement x="0" y="124" width="38" height="14" />
        <textElement verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="8" isBold="true" />
        </textElement>
        <text><![CDATA[Date :]]></text>
      </staticText>
      <textField isBlankWhenNull="true">
        <reportElement x="40" y="124" width="100" height="14" />
        <textElement verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="8" />
        </textElement>
        <textFieldExpression><![CDATA[$P{receiptDate}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="175" y="124" width="90" height="14" />
        <textElement verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="8" isBold="true" />
        </textElement>
        <text><![CDATA[Annee Scolaire :]]></text>
      </staticText>
      <textField isBlankWhenNull="true">
        <reportElement x="268" y="124" width="90" height="14" />
        <textElement verticalAlignment="Middle">
          <font fontName="DejaVu Sans" size="8" />
        </textElement>
        <textFieldExpression><![CDATA[$P{academicYear}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="385" y="124" width="50" height="14" />
